{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn"
  ],
  "rules": {
    "curly": ["error", "all"],
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": ["error", "always"],
    "prefer-const": "error",
    "no-var": "error",
    "no-debugger": "error",
    "no-eval": "error"
  }
}
